# ==============================================================================
# Career Avsar - Production Environment Configuration (PM2 / Direct VPS / MongoDB Atlas)
# Path on VPS: /var/www/career-avsar/.env
# ==============================================================================

# Application & Network Binding (Bound strictly to localhost 127.0.0.1 on port 3003)
NODE_ENV=production
APP_NAME="Career Avsar"
APP_URL=https://careeravsar.in
NEXT_PUBLIC_APP_URL=https://careeravsar.in
PORT=3003
HOSTNAME=127.0.0.1

# Database - MongoDB Atlas Connection (Production Cloud Database)
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<ATLAS_USERNAME>:<ATLAS_PASSWORD>@<YOUR_CLUSTER>.mongodb.net/career_avsar?retryWrites=true&w=majority
MONGODB_DB_NAME=career_avsar

# Session Authentication & Security
# Generate a cryptographically secure random secret (min 32 characters), e.g. using `openssl rand -hex 32`
AUTH_SECRET=generate-a-secure-random-32-character-secret-key-here
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_SECONDS=604800

# File Storage Configuration (Local storage on VPS disk)
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_DIR=./uploads

# Logging & Performance
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1
