# Application
NODE_ENV=development
APP_NAME="Indian Teacher Recruitment Platform"
APP_URL=http://localhost:3000
PORT=3000

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/indian_teacher_recruitment
MONGODB_DB_NAME=indian_teacher_recruitment

# Authentication (strategy placeholders - configure per chosen provider/implementation)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_SECONDS=604800

# Authorization / RBAC (placeholders)
DEFAULT_USER_ROLE=candidate

# File storage (strategy placeholders)
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_DIR=./uploads
# S3-compatible (optional)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Logging
LOG_LEVEL=info

# Deployment (Hostinger VPS / Docker / Nginx)
NEXT_TELEMETRY_DISABLED=1
